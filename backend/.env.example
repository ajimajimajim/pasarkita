# Copy this file to ".env" (same folder). The database values match docker-compose.yml.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=pasarkita_user
DB_PASSWORD=pasarkita_pass
DB_NAME=pasarkita

# Change this to any long random text.
JWT_SECRET=change_me_to_a_long_random_text
JWT_EXPIRES_IN=8h

MAX_UPLOAD_MB=5
